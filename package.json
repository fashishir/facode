{
  "name": "facode-cli",
  "version": "0.4.3",
  "description": "FA Code — a Claude Code–style CLI agent built around REA (Reverse Engineering Anything).",
  "type": "module",
  "bin": {
    "facode": "bin/facode.js"
  },
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && tsc-alias",
    "dev": "tsx src/index.ts",
    "start": "node bin/facode.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "agent",
    "reverse-engineering",
    "rea",
    "mcp",
    "ink",
    "typescript"
  ],
  "author": "fashishir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fashishir/facode.git"
  },
  "homepage": "https://github.com/fashishir/facode#readme",
  "bugs": {
    "url": "https://github.com/fashishir/facode/issues"
  },
  "imports": {
    "#agent/*": "./dist/agent/*",
    "#tools/*": "./dist/tools/*",
    "#tui/*": "./dist/tui/*",
    "#config": "./dist/config.js",
    "#utils": "./dist/utils.js",
    "#session/*": "./dist/session/*",
    "#cli": "./dist/cli.js",
    "#mcp": "./dist/mcp.js",
    "#permissions": "./dist/permissions.js",
    "#subagents": "./dist/subagents.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "minimatch": "^10.2.6",
    "openai": "^7.43.0",
    "react": "^19.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
